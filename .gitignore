# Secrets — service-account keys, etc. NEVER commit. (.env is already ignored above.)
.secrets/

# Local assistant/tooling caches and generated backups
.cache/
.tmp/
# .claude/ is committed on purpose: it carries the calmbeach-team skill, which is
# part of how this project is worked on. Only the machine-local bits stay ignored.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.continue/
.codex/undo-*/
migrated_prompt_history/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env
.env.local
node_modules/
dist/
*.log
*.pid
.codex/
.agents/
test-results/

# Local QA screenshots/scratch
tmp/
reports/photo-coverage/qa/
reports/photo-coverage/qa-img/
reports/photo-coverage/qa-focus/
reports/visual-qa/
reports/tmp-*/
OUT.txt

# Capacitor / native app store packaging
# Generated icon/splash sources (reproducible via `npm run native:assets`)
cap-assets/
store-assets/
# Android signing keys — NEVER commit; keep an offline backup
*.jks
*.keystore
keystore.properties
# iOS native project pods (added later on macOS)
ios/App/Pods/

# Internal, non-shippable, or sensitive-in-a-public-repo files
# (repo is public — keep competitive strategy, GSC analytics data and the
# machine-specific MCP config out of git so they never get pushed by accident)
.mcp.json
docs/competitor-strategy.md
reports/snapshots/

# Baked SQLite database — a build artifact regenerated from the canonical JSON
# via `npm run build:sqlite`; not committed (binary, 1.7MB).
public/data/beaches.sqlite
public/data/beaches.sqlite-wal
public/data/beaches.sqlite-shm

# Build/analysis artifact — whole-country SQLite, never served (see sqlite-verdict)
data/derived/

# Local Netlify folder
.netlify

# Netlify edge bootstrap lockfile — regenerated by `netlify dev`, never read by the build
# (netlify.toml declares no edge_functions; only netlify/functions, which are Node).
deno.lock
