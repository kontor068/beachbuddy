    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.14.0",
    "@types/react-virtualized-auto-sizer": "^1.0.4",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.0.0",
    "googleapis": "^173.0.0",
    "shapefile": "^0.6.6",
    "sharp": "^0.34.5",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
