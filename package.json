{
  "name": "calm-beach-greece",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:beach-data": "node scripts/buildBeachRegionData.mjs && node scripts/bakeLocalWindShelter.mjs && node scripts/splitBeachStories.mjs",
    "camping:harvest": "node scripts/harvestCampsitesOsm.mjs",
    "camping:link": "node scripts/linkCampsitesToBeaches.mjs match",
    "camping:apply": "node scripts/linkCampsitesToBeaches.mjs apply",
    "coverage:harvest": "node scripts/harvestBeachesOsm.mjs",
    "coverage:report": "node scripts/buildNationalGapReport.mjs",
    "paid:harvest": "node scripts/harvestPaidBeachesOsm.mjs",
    "paid:match": "node scripts/importPaidEntry.mjs match",
    "paid:apply": "node scripts/importPaidEntry.mjs apply",
    "audit:beaches": "node scripts/auditBeachDataset.mjs",
    "audit:cyclades-map-evidence": "node scripts/auditCycladesMapEvidence.mjs",
    "audit:cyclades-google-places": "node scripts/auditCycladesGooglePlaces.mjs",
    "audit:place-resolution": "node scripts/auditPlaceResolution.mjs",
    "audit:wind-profile-evidence": "node scripts/auditWindProfileEvidence.mjs",
    "validate:meltemi-matrix": "node scripts/validateMeltemiMatrix.mjs",
    "calibrate:feedback": "node scripts/calibrateFromFeedback.mjs",
    "quality:explain": "node scripts/runCriticalQualityChecks.mjs --explain",
    "quality:beach-data": "node scripts/validateCriticalBeachData.mjs",
    "quality:clock": "node scripts/validateAthensClock.mjs",
    "contract:check": "node scripts/checkBeachContract.mjs",
    "contract:check:full": "node scripts/checkBeachContract.mjs --detail",
    "build:sqlite": "node --experimental-sqlite scripts/buildBeachSqlite.mjs",
    "db:query": "node --experimental-sqlite scripts/queryBeaches.mjs",
    "quality:critical": "node scripts/runCriticalQualityChecks.mjs",
    "quality:auto": "node scripts/runCriticalQualityChecks.mjs --auto --max-attempts=3",
    "quality:planner": "node scripts/validatePlannerAgreement.mjs",
    "content:audit": "node scripts/auditStaticBeachContent.mjs",
    "seo:audit": "node scripts/auditSeoPrerender.mjs",
    "seo:prod:audit": "node scripts/auditProductionSeo.mjs",
    "perf:audit": "node scripts/auditBundlePerformance.mjs",
    "analytics:audit": "node scripts/auditAnalyticsFunnel.mjs",
    "seo:snapshot": "node scripts/seo-snapshot.mjs",
    "growth:audit": "npm run build && npm run seo:audit && npm run perf:audit && npm run analytics:audit",
    "visual:qa": "node scripts/visualQa.mjs",
    "photos:milos": "node scripts/findMilosBeachImages.mjs",
    "photos:destinations:cards": "node scripts/optimizeDestinationCardImages.mjs",
    "images:backgrounds": "node scripts/optimizeBackgroundImages.mjs",
    "images:strips": "node scripts/optimizeStripImages.mjs",
    "images:region-strips": "node scripts/buildRegionStripPhotos.mjs",
    "images:source-region-strips": "node scripts/sourceRegionStripImages.mjs",
    "build": "node scripts/checkBeachContract.mjs && node scripts/buildLegalPages.mjs && node scripts/splitBeachStories.mjs && node scripts/generateCuratedPhotoAvif.mjs && vite build && node scripts/stampServiceWorker.mjs && node scripts/prerenderBeachPages.mjs && node scripts/applyDeployContextGuards.mjs",
    "build:legal": "node scripts/buildLegalPages.mjs",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "native:assets": "node scripts/generateNativeIconSources.mjs && capacitor-assets generate --assetPath cap-assets",
    "cap:sync": "npm run build && cap sync",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@google/genai": "^1.16.0",
    "@netlify/blobs": "^10.7.9",
    "@tailwindcss/vite": "^4.2.1",
    "@types/leaflet": "^1.9.21",
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-firebase-hooks": "^5.1.1",
    "react-leaflet": "^5.0.0",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.2.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.14.0",
    "@types/react-virtualized-auto-sizer": "^1.0.4",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.0.0",
    "googleapis": "^173.0.0",
    "shapefile": "^0.6.6",
    "sharp": "^0.34.5",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
