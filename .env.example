# ---------------------------------------------------------------------------
# Client feature flags (VITE_-prefixed: baked into the bundle at build time).
# ---------------------------------------------------------------------------
# Multi-day trip planner strip on region pages. Default ON; set to false in
# the Netlify env + trigger a deploy to kill it without a code change.
VITE_ENABLE_TRIP_PLANNER=true

# Server/script-only photo API keys.
# Do not prefix these with VITE_ and do not commit real keys.
SITE_URL=https://calmbeach.gr
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
WIKIMEDIA_ENTERPRISE_ACCESS_TOKEN=
WIKIMEDIA_ENTERPRISE_USERNAME=
WIKIMEDIA_ENTERPRISE_PASSWORD=
WIKIMEDIA_ENTERPRISE_QUERY_LIMIT=3

# Server/script-only audit report email settings.
# Do not commit real keys or personal email addresses here.
RESEND_API_KEY=
AUDIT_EMAIL_FROM=BeachBuddy Audit <audit@example.com>
AUDIT_EMAIL_TO=you@example.com
AUDIT_EMAIL_CC=
AUDIT_EMAIL_BCC=
AUDIT_EMAIL_SUBJECT_PREFIX=BeachBuddy Audit Report

# Server-only user feedback notification for the Netlify feedback function.
# Delivered as an instant Telegram push (free, no email/DNS setup needed).
# 1) Create a bot via @BotFather -> get the token.
# 2) Message the bot once, then read your chat id from
#    https://api.telegram.org/bot<TOKEN>/getUpdates (result[].message.chat.id).
FEEDBACK_TELEGRAM_BOT_TOKEN=
FEEDBACK_TELEGRAM_CHAT_ID=

# Local admin GUI for audit reports and schedules.
AUDIT_ADMIN_TOKEN=change-this-local-admin-token
AUDIT_ADMIN_HOST=127.0.0.1
AUDIT_ADMIN_PORT=4187
AUDIT_ADMIN_RUN_TIMEOUT_MS=900000

# ---------------------------------------------------------------------------
# Google Search Console snapshot tool (scripts/seo-snapshot.mjs, LOCAL ONLY).
# Setup + beginner guide: reports/README.md
# ---------------------------------------------------------------------------
# Path to the service-account JSON key (NEVER commit this file; .secrets/ is
# git-ignored). Relative paths are resolved from the project root.
GSC_SA_KEY_PATH=./.secrets/gsc-key.json

# Your Search Console property. There are two kinds — use EXACTLY the one you
# added in Search Console (Settings -> Property, or the property switcher):
#   - Domain property        -> begins with "sc-domain:"   (covers all subdomains + http/https)
#   - URL-prefix property     -> a full URL with trailing slash
# How to tell which you have: open https://search.google.com/search-console —
# if the property is shown WITHOUT https:// (just "calmbeach.gr"), it is a
# Domain property; if it is shown as "https://calmbeach.gr/", it is URL-prefix.
# Uncomment ONE line below and leave the other commented:
# GSC_SITE_URL=sc-domain:calmbeach.gr
# GSC_SITE_URL=https://calmbeach.gr/
GSC_SITE_URL=
